<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760.0" prefWidth="1280.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alethanabooks.controlador.LibrosImportadosController">

    <top><fx:include source="header.fxml" /></top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #ffffff; -fx-background: #ffffff;">
            <VBox spacing="28.0" style="-fx-background-color: #ffffff;">
                <padding><Insets bottom="40" left="40" right="40" top="28" /></padding>

                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 32px; -fx-font-weight: 900;" text="Libros importados para ti" textFill="#0f172a" />
                        <Label style="-fx-font-size: 16px;" text="Ediciones internacionales seleccionadas especialmente para nuestros lectores." textFill="#64748b" />
                    </VBox>
                </HBox>

                <StackPane prefHeight="160.0" style="-fx-background-color: linear-gradient(to right, #5b8cff, #1e293b); -fx-background-radius: 18;">
                    <HBox alignment="CENTER_LEFT" prefHeight="135.0" prefWidth="1198.0" spacing="40.0">
                        <padding><Insets bottom="28" left="36" right="36" top="28" /></padding>
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 26px; -fx-font-weight: 900;" text="Colección Internacional 2026" textFill="white" />
                            <Label style="-fx-font-size: 15px;" text="Más de 200 títulos importados directamente de Europa y Norteamérica" textFill="#f0fff6" wrapText="true" />
                        </VBox>
                        <Label style="-fx-background-color: #f59e0b; -fx-background-radius: 12;  -fx-font-size: 20px; -fx-font-weight: 900; -fx-padding: 14 26;" text="Hasta 20% OFF" textFill="white" />
                    </HBox>
                </StackPane>

                <Label style="-fx-font-size: 22px; -fx-font-weight: 900;" text="Selección destacada" textFill="#0f172a" />

                <FlowPane fx:id="flowLibros" hgap="22.0" prefWrapLength="1200.0" style="-fx-background-color: transparent;" vgap="24.0" />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
