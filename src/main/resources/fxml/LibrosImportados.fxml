                        <StackPane prefHeight="220.0"
                                   style="-fx-background-color: #f8fafc; -fx-background-radius: 10;">
                            <ImageView fitHeight="210.0" fitWidth="154.0" preserveRatio="true">
                                <image><Image url="@../imagenes/la_sombra.jpg"/></image>
