                                   style="-fx-font-size: 18px; -fx-font-weight: 900;"
                                   textFill="#7c3aed"/>
                        </HBox>
                        <Button maxWidth="Infinity" text="Agregar al carrito"
                                textFill="white"
                                style="-fx-background-color: #f59e0b; -fx-background-radius: 10;
                                       -fx-font-size: 13px; -fx-font-weight: 800; -fx-padding: 9 0;"/>
                    </VBox>

                </FlowPane>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
