<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760.0" prefWidth="1280.0"
            style="-fx-background-color: #f8fafc;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alethanabooks.controlador.LibrosDigitalesController">

    <top>
        <fx:include source="header.fxml"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #f8fafc;">
            <VBox spacing="28">
                <padding><Insets bottom="40" left="36" right="36" top="30"/></padding>

                <!-- Hero banner digital -->
                <StackPane prefHeight="180"
                           style="-fx-background-color: linear-gradient(to right, #4c1d95, #7c3aed, #ec4899);
                                  -fx-background-radius: 18;">
                    <VBox alignment="CENTER_LEFT" spacing="10">
                        <padding><Insets left="48" right="48"/></padding>
                        <Label text="📥  Biblioteca Digital"
                               style="-fx-font-size: 38px; -fx-font-weight: 900;" textFill="white"/>
                        <Label text="Descarga instantánea · PDF · EPUB · MOBI · 10% de descuento automático en todos los e-books"
                               style="-fx-font-size: 16px; -fx-opacity: 0.9;" textFill="white"/>
                    </VBox>
                </StackPane>

                <!-- Barra de filtros -->
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <Label text="Filtrar por formato:"
                           style="-fx-font-size: 14px; -fx-font-weight: 700;" textFill="#334155"/>
                    <Button fx:id="btnTodos" text="Todos" onAction="#filtrarTodos"
                            style="-fx-background-color: #7c3aed; -fx-background-radius: 8;
                                   -fx-font-size: 13px; -fx-font-weight: 800; -fx-padding: 7 18;"
                            textFill="white"/>
                    <Button fx:id="btnPDF"  text="PDF"  onAction="#filtrarPDF"
                            style="-fx-background-color: #f1f5f9; -fx-background-radius: 8;
                                   -fx-border-color: #e5e7eb; -fx-font-size: 13px; -fx-padding: 7 18;"
                            textFill="#334155"/>
                    <Button fx:id="btnEPUB" text="EPUB" onAction="#filtrarEPUB"
                            style="-fx-background-color: #f1f5f9; -fx-background-radius: 8;
                                   -fx-border-color: #e5e7eb; -fx-font-size: 13px; -fx-padding: 7 18;"
                            textFill="#334155"/>
                    <Button fx:id="btnMOBI" text="MOBI" onAction="#filtrarMOBI"
                            style="-fx-background-color: #f1f5f9; -fx-background-radius: 8;
                                   -fx-border-color: #e5e7eb; -fx-font-size: 13px; -fx-padding: 7 18;"
                            textFill="#334155"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblConteo" text=""
                           style="-fx-font-size: 13px;" textFill="#64748b"/>
                </HBox>

                <!-- Grid de libros digitales -->
                <FlowPane fx:id="gridDigitales"
                          hgap="20" vgap="22"
                          prefWrapLength="900"
                          style="-fx-background-color: transparent;"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
