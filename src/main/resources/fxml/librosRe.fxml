<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760.0" prefWidth="1280.0"
            style="-fx-background-color: #ffffff;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alethanabooks.controlador.librosReControlador">

    <top><fx:include source="header.fxml" /></top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: #ffffff;">
            <VBox spacing="24.0" style="-fx-background-color: #ffffff;">
                <padding><Insets bottom="40.0" left="40.0" right="40.0" top="28.0" /></padding>

                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 32px; -fx-font-weight: 900;"
                               text="Libros recomendados para ti" textFill="#0f172a" />
                        <Label style="-fx-font-size: 16px;"
                               text="Una selección especial de libros que podrían interesarte."
                               textFill="#64748b" />
                    </VBox>
                    <Button style="-fx-background-color: linear-gradient(to right, #8E2DE2, #FF4E8D);
                                   -fx-background-radius: 12; -fx-font-size: 16px;
                                   -fx-font-weight: 800; -fx-padding: 14 24;"
                            text="Generar recomendación" textFill="white"
                            onAction="#onGenerarRecomendacion"/>
                </HBox>

                <!-- Panel agregar -->
                <VBox spacing="14.0"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-border-color: #e5e7eb; -fx-border-radius: 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <padding><Insets bottom="20" left="22" right="22" top="20"/></padding>
                    <Label text="Agregar libro recomendado"
                           style="-fx-font-size: 17px; -fx-font-weight: 900;" textFill="#0f172a"/>
                    <HBox spacing="10.0">
                        <TextField fx:id="txtTitulo" promptText="Título del libro" HBox.hgrow="ALWAYS"
                                   style="-fx-background-radius: 8; -fx-border-color: #e5e7eb;
                                          -fx-border-radius: 8; -fx-padding: 9 12; -fx-font-size: 13px;" />
                        <TextField fx:id="txtAutor" promptText="Autor" HBox.hgrow="ALWAYS"
                                   style="-fx-background-radius: 8; -fx-border-color: #e5e7eb;
                                          -fx-border-radius: 8; -fx-padding: 9 12; -fx-font-size: 13px;" />
                        <ComboBox fx:id="cmbCategoria" promptText="Categoría"
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                  style="-fx-background-radius: 8; -fx-border-color: #e5e7eb;
                                         -fx-border-radius: 8; -fx-font-size: 13px;" />
                        <TextField fx:id="txtPrecio" promptText="Precio (COP)" prefWidth="130"
                                   style="-fx-background-radius: 8; -fx-border-color: #e5e7eb;
                                          -fx-border-radius: 8; -fx-padding: 9 12; -fx-font-size: 13px;" />
                        <TextField fx:id="txtStock" promptText="Stock" prefWidth="80"
                                   style="-fx-background-radius: 8; -fx-border-color: #e5e7eb;
                                          -fx-border-radius: 8; -fx-padding: 9 12; -fx-font-size: 13px;" />
                        <Button text="+ Agregar" onAction="#onAgregar" textFill="white"
                                style="-fx-background-color: linear-gradient(to right, #8E2DE2, #FF4E8D);
                                       -fx-background-radius: 8; -fx-font-weight: 800;
                                       -fx-font-size: 13px; -fx-padding: 9 20;" />
                    </HBox>
                </VBox>

                <Label text="Libros disponibles"
                       style="-fx-font-size: 22px; -fx-font-weight: 900;" textFill="#0f172a"/>

                <FlowPane fx:id="flowLibros" hgap="22.0" prefWrapLength="1100.0"
                          style="-fx-background-color: #ffffff;" vgap="24.0"/>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>