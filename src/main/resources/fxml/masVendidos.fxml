<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="760.0" prefWidth="1280.0"
            style="-fx-background-color: #ffffff;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alethanabooks.controlador.MasVendidosController">

    <top><fx:include source="header.fxml" /></top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: #ffffff; -fx-background: #ffffff;">
            <VBox spacing="28.0" style="-fx-background-color: #ffffff;">
                <padding><Insets bottom="40" left="40" right="40" top="28"/></padding>

                <VBox spacing="6.0">
                    <Label text="Últimos añadidos"
                           style="-fx-font-size: 32px; -fx-font-weight: 900;" textFill="#0f172a" />
                    <Label text="Los 10 libros más recientes en nuestro catálogo."
                           style="-fx-font-size: 16px;" textFill="#64748b" />
                </VBox>

                <VBox fx:id="listaLibros" spacing="16.0" />
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>