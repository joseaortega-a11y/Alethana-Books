      <Button fx:id="btnAdmin" layoutX="281.0" layoutY="341.0" mnemonicParsing="false" onAction="#onAdmin" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: linear-gradient(to right, #FF4E8D, #8E2DE2); -fx-background-radius: 10; -fx-border-radius: 10; -fx-padding: 5 20; -fx-font-weight: 700;" text="Admin" textFill="WHITE" />

