<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="762.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alethanabooks.controlador.InicioController">

    <top>
        <fx:include source="header.fxml" />
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #ffffff;">
            <HBox style="-fx-background-color: #ffffff;">


                <VBox fx:id="sidebarCategorias" maxWidth="210.0" minWidth="190.0" prefWidth="200.0" spacing="6.0" style="-fx-background-color: #ffffff; -fx-border-color: transparent #e5e7eb transparent transparent;">
                    <padding>
                        <Insets bottom="30.0" left="14.0" right="14.0" top="26.0" />
                    </padding>
                    <Label style="-fx-font-size: 23px; -fx-font-weight: 900;" text="Categorias" textFill="#0f172a" />
                </VBox>


                <VBox spacing="24.0" style="-fx-background-color: #ffffff;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="40.0" left="24.0" right="24.0" top="28.0" />
                    </padding>


                    <StackPane prefHeight="300.0" style="-fx-background-color: linear-gradient(to right, #7c3aed, #ec4899); -fx-background-radius: 16;">
                        <HBox alignment="CENTER" spacing="38.0">
                            <VBox alignment="CENTER_LEFT" spacing="14.0">
                                <Label style="-fx-font-size: 44px; -fx-font-weight: 900;" text="Cyber Days" textFill="#10b981" />
                                <VBox spacing="-6.0">
                                    <Label style="-fx-font-size: 40px; -fx-font-weight: 800;" text="Hasta 20%" textFill="white" />
                                    <Label prefHeight="75.0" prefWidth="541.0" style="-fx-font-size: 40px; -fx-font-weight: 800;" text="OFF con códigos " textFill="white" />
                                    <Label prefHeight="75.0" prefWidth="541.0" style="-fx-font-size: 40px; -fx-font-weight: 800;" text="promocionales " textFill="white" />
                                </VBox>
                            </VBox>
                            <HBox fx:id="bannerPortadas" alignment="CENTER" spacing="14.0" />
                        </HBox>
                    </StackPane>

                    <VBox prefHeight="17.0" prefWidth="754.0" spacing="22.0">
                        <HBox alignment="CENTER_LEFT">
                            <Region HBox.hgrow="ALWAYS" />
                        </HBox>
                         <Label prefHeight="25.0" prefWidth="464.0" style="-fx-font-size: 26px; -fx-font-weight: 900;" text="Categorias / Resultados de busquedas" textFill="#0f172a" />
                  <Label text="Aquí veras tus libros por categorias y tus resultados de busqueda" />
                        <FlowPane fx:id="gridLibros" hgap="18.0" prefWrapLength="800.0" style="-fx-background-color: transparent;" vgap="20.0" />
                    </VBox>
                </VBox>

                <VBox maxWidth="300.0" minWidth="255.0" prefWidth="280.0" spacing="18.0" style="-fx-background-color: #ffffff; -fx-border-color: transparent transparent transparent #e5e7eb;">
                    <padding>
                        <Insets bottom="30.0" left="20.0" right="20.0" top="26.0" />
                    </padding>
                    <Label style="-fx-font-size: 23px; -fx-font-weight: 900;" text="Novedades en libros" textFill="#0f172a" />
                    <VBox fx:id="sidebarNovedad" spacing="16.0" style="-fx-background-color: #fff7fd; -fx-background-radius: 16;                                  -fx-border-color: #eadcf8; -fx-border-radius: 16;">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>
                </VBox>

            </HBox>
        </ScrollPane>
    </center>
</BorderPane>
