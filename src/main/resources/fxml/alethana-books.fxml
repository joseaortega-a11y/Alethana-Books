<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="762.0" prefWidth="1280.0"
            style="-fx-background-color: #ffffff;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.alethanabooks.controlador.InicioController">

    <top>
        <fx:include source="header.fxml" />
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #ffffff;">
            <HBox style="-fx-background-color: #ffffff;">

                <!-- ══════  SIDEBAR CATEGORÍAS  ══════ -->
                <VBox fx:id="sidebarCategorias"
                      maxWidth="210.0" minWidth="190.0" prefWidth="200.0" spacing="6.0"
                      style="-fx-background-color: #ffffff; -fx-border-color: transparent #e5e7eb transparent transparent;">
                    <padding>
                        <Insets bottom="30.0" left="14.0" right="14.0" top="26.0" />
                    </padding>
                    <Label style="-fx-font-size: 23px; -fx-font-weight: 900;"
                           text="Categorias" textFill="#0f172a" />
                </VBox>

                <!-- ══════  CONTENIDO CENTRAL  ══════ -->
                <VBox spacing="24.0" style="-fx-background-color: #ffffff;" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="40.0" left="24.0" right="24.0" top="28.0" />
                    </padding>

                    <!-- Banner hero -->
                    <StackPane prefHeight="300.0"
                               style="-fx-background-color: linear-gradient(to right, #7c3aed, #ec4899); -fx-background-radius: 16;">
                        <HBox alignment="CENTER" spacing="38.0">
                            <VBox alignment="CENTER_LEFT" spacing="14.0">
                                <Label style="-fx-font-size: 44px; -fx-font-weight: 900;"
                                       text="Cyber Days" textFill="#10b981" />
                                <VBox spacing="-6.0">
                                    <Label style="-fx-font-size: 52px; -fx-font-weight: 900;"
                                           text="Hasta 70%" textFill="white" />
                                    <Label style="-fx-font-size: 52px; -fx-font-weight: 900;"
                                           text="OFF" textFill="white" />
                                </VBox>
                                <Button prefHeight="50.0" prefWidth="152.0"
                                        style="-fx-background-color: white; -fx-background-radius: 11; -fx-font-size: 18px; -fx-font-weight: 800;"
                                        text="Ver mas" textFill="#7c3aed" />
                            </VBox>
                            <!-- Portadas dinámicas -->
                            <HBox fx:id="bannerPortadas" alignment="CENTER" spacing="14.0" />
                        </HBox>
                    </StackPane>

                    <!-- Banners promocionales -->
                    <HBox spacing="20.0">
                        <VBox prefHeight="125.0" spacing="10.0"
                              style="-fx-background-color: #6d28d9; -fx-background-radius: 14;" HBox.hgrow="ALWAYS">
                            <padding><Insets bottom="20.0" left="24.0" right="24.0" top="24.0" /></padding>
                            <Label style="-fx-font-size: 24px; -fx-font-weight: 900;"
                                   text="Mas vendidos 2026" textFill="white" />
                            <Label style="-fx-font-size: 16px;"
                                   text="Descubre los títulos favoritos del año" textFill="white" wrapText="true" />
                        </VBox>
                        <VBox prefHeight="125.0" spacing="10.0"
                              style="-fx-background-color: #0ea574; -fx-background-radius: 14;" HBox.hgrow="ALWAYS">
                            <padding><Insets bottom="20.0" left="24.0" right="24.0" top="24.0" /></padding>
                            <Label style="-fx-font-size: 24px; -fx-font-weight: 900;"
                                   text="Envio gratis" textFill="white" />
                            <Label style="-fx-font-size: 16px;"
                                   text="En libros seleccionados" textFill="white" />
                        </VBox>
                        <VBox prefHeight="125.0" spacing="10.0"
                              style="-fx-background-color: #f59e0b; -fx-background-radius: 14;" HBox.hgrow="ALWAYS">
                            <padding><Insets bottom="20.0" left="24.0" right="24.0" top="24.0" /></padding>
                            <Label style="-fx-font-size: 24px; -fx-font-weight: 900;"
                                   text="Mega promo" textFill="white" />
                            <Label style="-fx-font-size: 16px;"
                                   text="Hasta 40% de descuento" textFill="white" />
                        </VBox>
                    </HBox>

                    <!-- Catálogo dinámico -->
                    <VBox spacing="22.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 26px; -fx-font-weight: 900;"
                                   text="Libros importados mas vendidos" textFill="#0f172a" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label style="-fx-font-size: 16px;" text="Ver todos >" textFill="#7c3aed" />
                        </HBox>
                        <FlowPane fx:id="gridLibros"
                                  hgap="18.0" vgap="20.0"
                                  prefWrapLength="800.0"
                                  style="-fx-background-color: transparent;" />
                    </VBox>
                </VBox>

                <!-- ══════  SIDEBAR DERECHO — novedad dinámica  ══════ -->
                <VBox maxWidth="300.0" minWidth="255.0" prefWidth="280.0" spacing="18.0"
                      style="-fx-background-color: #ffffff; -fx-border-color: transparent transparent transparent #e5e7eb;">
                    <padding>
                        <Insets bottom="30.0" left="20.0" right="20.0" top="26.0" />
                    </padding>
                    <Label style="-fx-font-size: 23px; -fx-font-weight: 900;"
                           text="Novedades en libros" textFill="#0f172a" />
                    <VBox fx:id="sidebarNovedad" spacing="16.0"
                          style="-fx-background-color: #fff7fd; -fx-background-radius: 16;
                                 -fx-border-color: #eadcf8; -fx-border-radius: 16;">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>
                </VBox>

            </HBox>
        </ScrollPane>
    </center>
</BorderPane>