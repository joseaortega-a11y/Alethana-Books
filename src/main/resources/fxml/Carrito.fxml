<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="680.0" prefWidth="860.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.alethanabooks.controlador.CarritoController">

    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #7c3aed, #ec4899);">
            <padding><Insets bottom="18" left="28" right="28" top="18" /></padding>
            <Label style="-fx-font-size: 22px; -fx-font-weight: 900;" text="Tu carrito de compras" textFill="white" />
        </VBox>
    </top>

    <center>
        <HBox spacing="24" style="-fx-background-color: #f8fafc;">
            <padding><Insets bottom="28" left="28" right="28" top="24" /></padding>

            <VBox spacing="14" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-size: 18px; -fx-font-weight: 900;" text="Productos" textFill="#0f172a" />
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="340" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox fx:id="listaItems" spacing="12" />
                </ScrollPane>

                <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12;                                          -fx-border-color: #e5e7eb; -fx-border-radius: 12;">
                    <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
                    <Label style="-fx-font-size: 14px; -fx-font-weight: 800;" text="Código de descuento" textFill="#0f172a" />
                    <HBox spacing="10">
                        <TextField fx:id="txtCodigo" promptText="Ej: CYBER20" style="-fx-background-radius: 8; -fx-border-color: #e5e7eb;                                           -fx-border-radius: 8; -fx-padding: 9 12; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                        <Button onAction="#onAplicarCodigo" style="-fx-background-color: #7c3aed; -fx-background-radius: 8;                                        -fx-font-weight: 800; -fx-font-size: 13px; -fx-padding: 9 18;" text="Aplicar" textFill="white" />
                    </HBox>
                    <Label fx:id="lblDescuento" style="-fx-font-size: 13px;" text="" textFill="#10b981" />
                </VBox>
            </VBox>

            <VBox prefWidth="280" spacing="16">

                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 14;                                           -fx-border-color: #e5e7eb; -fx-border-radius: 14;">
                    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                    <Label style="-fx-font-size: 16px; -fx-font-weight: 900;" text="Resumen del pedido" textFill="#0f172a" />
                    <HBox>
                        <Label style="-fx-font-size: 14px;" text="Subtotal" textFill="#64748b" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblSubtotal" style="-fx-font-size: 14px;" text=" COP 0" textFill="#0f172a" />
                    </HBox>
                    <HBox>
                        <Label style="-fx-font-size: 14px;" text="Descuento" textFill="#64748b" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblMontoDescuento" style="-fx-font-size: 14px;" text="- COP 0" textFill="#10b981" />
                    </HBox>
                    <Separator />
                    <HBox>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: 900;" text="TOTAL" textFill="#0f172a" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotal" style="-fx-font-size: 18px; -fx-font-weight: 900;" text=" COP 0" textFill="#7c3aed" />
                    </HBox>
                </VBox>

                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 14;                                           -fx-border-color: #e5e7eb; -fx-border-radius: 14;">
                    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                    <Label style="-fx-font-size: 16px; -fx-font-weight: 900;" text="Método de pago" textFill="#0f172a" />
                    <RadioButton fx:id="rbTarjeta" style="-fx-font-size: 13px;" text="Tarjeta de crédito/débito" textFill="#0f172a" />
                    <RadioButton fx:id="rbPSE" style="-fx-font-size: 13px;" text="PSE — Pago en línea" textFill="#0f172a" />
                    <RadioButton fx:id="rbEfecty" style="-fx-font-size: 13px;" text="Efecty / Baloto" textFill="#0f172a" />
                </VBox>

                <Button maxWidth="Infinity" onAction="#onConfirmarCompra" style="-fx-background-color: linear-gradient(to right, #7c3aed, #ec4899);                                -fx-background-radius: 12; -fx-font-size: 16px;                                -fx-font-weight: 900; -fx-padding: 15;" text="Confirmar compra" textFill="white" />

                <Button maxWidth="Infinity" onAction="#onCerrar" style="-fx-background-color: #f1f5f9; -fx-background-radius: 12;                                -fx-font-size: 14px; -fx-font-weight: 700; -fx-padding: 12;" text="Seguir comprando" />
            </VBox>
        </HBox>
    </center>
</BorderPane>
