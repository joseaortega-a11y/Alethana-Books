<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1">

    <StackPane prefHeight="48.0"
               style="-fx-background-color: linear-gradient(to right, #7c3aed, #ec4899);">
        <HBox alignment="CENTER" spacing="22.0">
            <Label text="Cyber Days: hasta 70% de descuento en libros seleccionados"
                   textFill="white"
                   style="-fx-font-size: 16px; -fx-font-weight: 800;" />
            <Label text="Ver ofertas"
                   textFill="white"
                   style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-underline: true;" />
        </HBox>
    </StackPane>

    <HBox alignment="CENTER_LEFT"
          prefHeight="82.0"
          spacing="22.0"
          style="-fx-background-color: #ffffff; -fx-border-color: transparent transparent #e5e7eb transparent;">
        <padding>
            <Insets left="28.0" right="28.0" />
        </padding>

        <VBox alignment="CENTER" prefHeight="69.0" prefWidth="193.0" spacing="3.0">
            <Label text="Alethana Books"
                   textFill="#7c3aed"
                   style="-fx-font-size: 25px; -fx-font-weight: 900;" />
            <Label text="Enviar a Bogota, Colombia"
                   textFill="#64748b"
                   style="-fx-font-size: 14px;" />
        </VBox>

        <HBox alignment="CENTER_LEFT"
              maxHeight="52.0"
              maxWidth="721.0"
              prefHeight="52.0"
              prefWidth="721.0"
              HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-border-color: #dfe3ea; -fx-border-radius: 11; -fx-background-radius: 11;">

            <TextField promptText="Buscar por titulo o autor"
                       maxHeight="50.0"
                       minHeight="50.0"
                       prefHeight="50.0"
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color: transparent; -fx-background-radius: 11 0 0 11; -fx-font-size: 17px; -fx-padding: 0 18;" />

            <Button text="Buscar"
                    maxHeight="50.0"
                    maxWidth="110.0"
                    minHeight="50.0"
                    minWidth="110.0"
                    prefHeight="50.0"
                    prefWidth="110.0"
                    textFill="white"
                    style="-fx-background-color: #7c3aed; -fx-background-radius: 0 10 10 0; -fx-font-size: 16px; -fx-font-weight: 800;" />
        </HBox>

        <HBox alignment="CENTER" maxHeight="50.0" minHeight="50.0" prefHeight="50.0" prefWidth="274.0" spacing="12.0">

            <Button contentDisplay="GRAPHIC_ONLY"
                    maxHeight="40.0"
                    maxWidth="40.0"
                    minHeight="40.0"
                    minWidth="40.0"
                    prefHeight="40.0"
                    prefWidth="40.0"
                    style="-fx-background-color: transparent; -fx-padding: 0;">
                <graphic>
                    <SVGPath fill="#39393A"
                             scaleX="1.18"
                             scaleY="1.18"
                             content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45C4.52 15.37 5.48 17 7 17h12v-2H7l1.1-2h7.45c.75 0 1.41-.41 1.75-1.03L21 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2S15.9 22 17 22s2-.9 2-2-.9-2-2-2z" />
                </graphic>
            </Button>

            <Button contentDisplay="GRAPHIC_ONLY"
                    maxHeight="40.0"
                    maxWidth="40.0"
                    minHeight="40.0"
                    minWidth="40.0"
                    prefHeight="40.0"
                    prefWidth="40.0"
                    style="-fx-background-color: transparent; -fx-padding: 0;">
                <graphic>
                    <SVGPath fill="#ec4899"
                             scaleX="1.15"
                             scaleY="1.15"
                             content="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                </graphic>
            </Button>

            <Button contentDisplay="GRAPHIC_ONLY"
                    maxHeight="40.0"
                    maxWidth="40.0"
                    minHeight="40.0"
                    minWidth="40.0"
                    prefHeight="40.0"
                    prefWidth="40.0"
                    style="-fx-background-color: transparent; -fx-padding: 0;">
                <graphic>
                    <SVGPath fill="#10b981"
                             scaleX="1.15"
                             scaleY="1.15"
                             content="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z" />
                </graphic>
            </Button>

            <HBox alignment="CENTER" spacing="8.0">
                <Label text="Mi Cuenta"
                       textFill="#0f172a"
                       style="-fx-font-size: 14px; -fx-font-weight: 700;" />
                <VBox alignment="CENTER" spacing="0.0">
                    <Region prefHeight="8.0" prefWidth="28.0" style="-fx-background-color: #facc15;" />
                    <Region prefHeight="6.0" prefWidth="28.0" style="-fx-background-color: #1d4ed8;" />
                    <Region prefHeight="6.0" prefWidth="28.0" style="-fx-background-color: #dc2626;" />
                </VBox>
            </HBox>
        </HBox>
    </HBox>

    <HBox alignment="CENTER_LEFT"
          prefHeight="48.0"
          spacing="28.0"
          style="-fx-background-color: #f8fafc; -fx-border-color: transparent transparent #e5e7eb transparent;">
        <padding>
            <Insets left="28.0" right="28.0" />
        </padding>

        <Label text="Menú -&gt;" textFill="#0f172a" style="-fx-font-size: 16px; -fx-font-weight: 800;" />
        <Label text="Libros recomendados" textFill="#0f172a" style="-fx-font-size: 16px;" />
        <Label text="Mas vendidos" textFill="#0f172a" style="-fx-font-size: 16px;" />
        <Label text="Libros importados" textFill="#0f172a" style="-fx-font-size: 16px;" />
        <Label text="Club de lectura" textFill="#0f172a" style="-fx-font-size: 16px;" />
        <Label text="Opiniones de clientes" textFill="#0f172a" style="-fx-font-size: 16px;" />
    </HBox>
</VBox>